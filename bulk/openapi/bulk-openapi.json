  "paths": {
    "/additional/get-node-tree/{clientId}/repository/{repository}": {
      "post": {
        "operationId": "AdditionalOperations_getNodeTree",
        "description": "Get the tree structure below nodes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RepositoryContext.clientId"
          },
          {
            "$ref": "#/components/parameters/RepositoryContext.repository"
          },
          {
            "$ref": "#/components/parameters/GetNodeTreeRequest.depthLimit"
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the operation. `success` is `false` when the operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LionwebResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request 400. The request is malformed."
          },
          "401": {
            "description": "Unauthorized 401. Invalid token or no token provided."
          },
          "412": {
            "description": "PreconditionFailed 412. A parameter or the request body is missing or invalid, or validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreconditionFailed"
                }
              }
            }
          }
        },
        "tags": [
          "Additional"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdsRequest"
              }
            }
          }
        }
      }
    },
