  "components": {
    "parameters": {
      "BulkIdsRequest.count": {
        "name": "count",
        "in": "query",
        "required": false,
        "description": "Number of ids to reserve.",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "explode": false
      },
      "BulkRetriveRequest.depthLimit": {
        "name": "depthLimit",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "explode": false
      },
      "GetNodeTreeRequest.depthLimit": {
        "name": "depthLimit",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "explode": false
      },
      "RepositoryContext.clientId": {
        "name": "clientId",
        "in": "path",
        "required": true,
        "description": "Cliente Id",
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      },
      "RepositoryContext.repository": {
        "name": "repository",
        "in": "path",
        "required": true,
        "description": "Repository",
        "schema": {
          "$ref": "#/components/schemas/Identifier"
        }
      }
    },
    "schemas": {
      "AdditionalInfo": {
        "type": "object",
        "required": [
          "kind",
          "message",
          "data"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Identifier"
          },
          "distribute": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyValue"
            }
          }
        }
      },
      "BulkImport": {
        "type": "object"
      },
      "BulkImportRequest": {
        "type": "object",
        "required": [
          "clientId",
          "repository"
        ],
        "properties": {
          "clientId": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Cliente Id"
          },
          "repository": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Repository"
          }
        }
      },
      "BulkStoreRequest": {
        "type": "object",
        "required": [
          "clientId",
          "repository"
        ],
        "properties": {
          "clientId": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Cliente Id"
          },
          "repository": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Repository"
          }
        }
      },
      "Chunk": {
        "type": "object"
      },
      "CreatePartitionRequest": {
        "type": "object",
        "required": [
          "clientId",
          "repository"
        ],
        "properties": {
          "clientId": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Cliente Id"
          },
          "repository": {
            "$ref": "#/components/schemas/Identifier",
            "description": "Repository"
          }
        }
      },
      "Database": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DeletePartitionRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LionWebId"
            }
          }
        }
      },
      "Identifier": {
        "type": "string",
        "pattern": "[a-zA-Z0-9_-]+",
        "description": "LionWeb Idenfier"
      },
      "IdsRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LionWebId"
            }
          }
        },
        "description": "Array of LionWeb ids."
      },
      "KeyValue": {
        "type": "object"
      },
      "LionWebId": {
        "type": "string",
        "pattern": "[a-zA-Z0-9_-]+",
        "description": "A LionWeb node id."
      },
      "LionWebJsonChunk": {
        "type": "object",
        "description": "LionWeb JSON Chunck."
      },
      "LionwebResponse": {
        "type": "object",
        "required": [
          "success",
          "chunk"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "chunk": {
            "$ref": "#/components/schemas/Chunk"
          },
          "additionalInfos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdditionalInfo"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponseMessage"
            }
          }
        },
        "description": "Result of the operation. `success` is `false` when the operation failed."
      },
      "ListPartitionsResponse": {
        "type": "object",
        "description": "List of partition response"
      },
      "NodeTreeResult": {
        "type": "object",
        "description": "Node Tree Result"
      },
      "PreconditionFailed": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "description": "PreconditionFailed 412. A parameter or the request body is missing or invalid, or validation failed."
      },
      "Repository": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ResponseMessage": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Kind of message, e.g. `Info`, `PartitionHasParent`, `PartitionHasChildren`,`PartitionHasAnnotations`, `EmptyChunk`, `NullChunk`, `IdsIncorrect`,`PartitionAlreadyExists`, `NodeIsNotPartition`, `EmptyIdList`, `IdsNotFound`,`ParentMissing`, `NotImplemented`, `DepthLimitIncorrect`, or a validation issue kind."
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  }
}
