          "412": {
            "description": "PreconditionFailed 412. A parameter or the request body is missing or invalid, or validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreconditionFailed"
                }
              }
            }
